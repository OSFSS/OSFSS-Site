<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__contact">
        <p class="site-footer__email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <span>Contact us: <a href="{{ site.footer.emailUrl }}">{{ site.footer.email }}</a></span>
        </p>
        <p>{{ site.footer.address }}</p>
        <a class="btn btn--join-dark js-join-trigger" style="margin-top:14px" href="{{ site.joinUrl }}">Join now</a>
      </div>
      <div class="site-footer__nav-col">
        <nav>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/#about">About Us</a></li>
            <li><a href="/#termcard">Termcard</a></li>
            <li><a href="/blog/">Blog</a></li>
          </ul>
        </nav>
        <div class="site-footer__social">
          {% for s in site.social %}
          <a href="{{ s.url }}" target="_blank" rel="noopener"><img src="{{ s.icon }}" alt="{{ s.name }}"></a>
          {% endfor %}
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <a class="site-footer__logo" href="/"><img src="/assets/img/logo-white.png" alt="{{ site.name }}"></a>
      <div class="site-footer__partners">
        <a href="https://www.smithschool.ox.ac.uk/research/sustainable-finance/" target="_blank" rel="noopener"><img src="/assets/img/osfg-logo-footer.png" alt="Oxford Sustainable Finance Group"></a>
        <a href="https://www.smithschool.ox.ac.uk/research/sustainable-law/index.html#overview" target="_blank" rel="noopener"><img src="/assets/img/oxsl-logo.png" alt="Oxford Sustainable Law Programme"></a>
      </div>
    </div>
  </div>
</footer>
