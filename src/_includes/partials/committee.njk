<section class="section committee" id="committee">
  <div class="wrap">
    <h2 class="committee__heading">OSFSS Committee 2026/27</h2>
    <h3 class="committee__subheading">Society Officers</h3>
    {% for stream in committee.streams %}
      {% if not loop.first %}<h3 class="committee__stream-title">{{ stream.name }}</h3>{% endif %}
      <div class="committee-grid" style="{% if loop.first %}margin-top:32px{% endif %}">
        {% for m in stream.members %}
        {% if m.linkedin %}<a class="committee-card" href="{{ m.linkedin }}" target="_blank" rel="noopener">{% else %}<div class="committee-card">{% endif %}
          {% if m.photo %}
          <img class="committee-card__photo" src="{{ m.photo }}" alt="{{ m.name }}">
          {% else %}
          <div class="committee-card__photo committee-card__photo--placeholder">{{ m.name | initials }}</div>
          {% endif %}
          <h4>{{ m.name }}</h4>
          <p class="committee-card__role">{{ m.role }}</p>
          <p class="committee-card__course">{{ m.course }}</p>
          <p class="committee-card__college">{{ m.college }}</p>
          {% if m.linkedin %}
          <div class="committee-card__social">
            <img src="/assets/img/icon-linkedin.png" alt="LinkedIn">
          </div>
          {% endif %}
        {% if m.linkedin %}</a>{% else %}</div>{% endif %}
        {% endfor %}
      </div>
    {% endfor %}
    <div class="committee-cta">
      <h3>Join Our Committee</h3>
      <p>We're gearing up to recruit the rest of our committee soon. Here's what you'll get out of it:</p>
      <ul class="committee-cta__benefits">
        <li>Add real, tangible experience to your CV</li>
        <li>Network with like-minded peers across the university</li>
        <li>Gain hands-on experience organising events, talks and campaigns</li>
        <li>Be part of committee dinners, socials and end-of-term celebrations</li>
        <li>Work directly with speakers, partners and industry professionals</li>
      </ul>
      <a class="btn" href="{{ site.committeeApplyUrl or '#' }}">Apply now</a>
    </div>
  </div>
</section>
