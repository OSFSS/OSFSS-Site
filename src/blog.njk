---
layout: base.njk
title: Blog
permalink: /blog/
header_solid: true
---
<div class="section">
  <div class="wrap blog-list">
    {% for post in collections.posts %}
    <a class="blog-card" href="{{ post.url }}">
      <img src="{{ post.data.image }}" alt="{{ post.data.title }}">
      <div>
        <p class="blog-card__meta">
          <span class="post-header__meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>{{ post.data.author or "OSFSS Committee" }}</span>
          <span>&middot;</span>
          <span class="post-header__meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>{{ post.data.date | readableDate }}</span>
          <span>&middot;</span>
          <span class="post-header__meta-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>{{ post.data.readTime }}</span>
        </p>
        <h2>{{ post.data.title }}</h2>
        <p>{{ post.data.excerpt }}</p>
      </div>
    </a>
    {% endfor %}
  </div>
</div>
